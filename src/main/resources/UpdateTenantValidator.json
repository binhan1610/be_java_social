{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UpdateTenant",
  "type": "object",
  "required": ["fullName", "phone", "identityCard"],
  "properties": {
    "fullName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 150,
      "pattern": "^(?!\\s*$).+"
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+?[0-9]{9,15}$"
    },
    "identityCard": {
      "type": "string",
      "minLength": 6,
      "maxLength": 30,
      "pattern": "^(?!\\s*$).+"
    },
    "imageUrl": {
      "type": "string",
      "maxLength": 500
    }
  }
}
