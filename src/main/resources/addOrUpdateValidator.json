{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AddOrUpdateBuilding",
  "type": "object",
  "required": ["name", "address"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^(?!\\s*$).+"
    },
    "address": {
      "type": "string",
      "minLength": 5,
      "maxLength": 500
    }
  }
}
