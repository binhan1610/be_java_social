{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AddTenantWithContract",
  "type": "object",
  "required": ["fullName", "phone", "identityCard", "roomId", "duration", "depositAmount"],
  "properties": {
    "fullName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 150,
      "pattern": "^(?!\\s*$).+"
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+?[0-9]{9,15}$"
    },
    "identityCard": {
      "type": "string",
      "minLength": 6,
      "maxLength": 30,
      "pattern": "^(?!\\s*$).+"
    },
    "imageUrl": {
      "type": "string",
      "maxLength": 500
    },
    "roomId": {
      "type": "integer",
      "minimum": 1
    },
    "duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*M$"
    },
    "depositAmount": {
      "type": "integer",
      "minimum": 0
    },
    "contractStatus": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    }
  }
}
