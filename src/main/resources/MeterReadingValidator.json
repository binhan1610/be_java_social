{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MeterReading",
  "type": "object",
  "required": ["roomId", "month", "year", "electricOld", "electricNew", "waterOld", "waterNew"],
  "properties": {
    "roomId": {
      "type": "integer",
      "minimum": 1
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100
    },
    "electricOld": {
      "type": "integer",
      "minimum": 0
    },
    "electricNew": {
      "type": "integer",
      "minimum": 0
    },
    "waterOld": {
      "type": "integer",
      "minimum": 0
    },
    "waterNew": {
      "type": "integer",
      "minimum": 0
    }
  }
}
