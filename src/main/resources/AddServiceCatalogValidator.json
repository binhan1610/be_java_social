{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AddServiceCatalog",
  "type": "object",
  "required": ["name", "price", "unit"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 150,
      "pattern": "^(?!\\s*$).+"
    },
    "price": {
      "type": "integer",
      "minimum": 0
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    }
  }
}
